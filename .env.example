# MindBridge Campaign — Environment Variables
# Copy this file to .env.local for local development with `vercel dev`
# In Vercel Dashboard: Settings → Environment Variables → add each key

# ── SMTP Email Configuration ───────────────────────────────────────────────
# Use Gmail App Password (not your normal Gmail password).
# To generate: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Recipient (SO4MH Campaign Team Inbox) ─────────────────────────────────
CAMPAIGN_EMAIL=info@standout4mentalhealth.org

# ── Optional: Campaign name shown in emails ────────────────────────────────
CAMPAIGN_NAME=MindBridge #100for100 Campaign

